--- !u!114 &1438911342
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000013221123710}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d943a105b50d262498e110df31b3b815, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  url: https://docs.google.com/spreadsheets/d/e/2PACX-1vR_IX7b2VUn8q2_yvC3lD2JpNxZZiObI31lFeyX2OV-eqc3OYlrQ9U_ffo1kiKeHgvtpVi0v5hvQ54s/pub?gid=1439257343&single=true&output=tsv
  file_in_server: {fileID: 4900000, guid: 5722f4c8d64ae384ab29643ee2b1f17d, type: 3}
  content:
  - type: 1
    title: '"NO PARARON DE CAMINAR"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. LISTO EL POLLO, PELADA LA GALLINA.'
    copete: QUE VIVA EL FUBOL
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. NADA QUE HACER PARA [team2].'
    copete: SIGA PARTICIPANDO
    text: "El equipo de [team1] se fue de la cancha al cantico de \"Piden penal,
      no les dan\". Sus contrincantes utilizar\xF3n todos los artilugios para poder
      sacar una diferencia pero [team1] fue completramente superior."
    param: played_difGoles=5
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: "\"MUY MALO EL \xC1RBITRO\""
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. GRACIAS POR TANTO PERD\xD3N POR TAN POCO [team1]."
    copete: "\xCDDOLOS"
    text: "[team1] marca tendencia en la calidad de su fubol y de sus jugadores.
      El director t\xE9cnico dice que har\xE1 un libro donde revelar\xE1 toda su
      sabidur\xEDa a los simples mortales."
    param: played_difGoles=5
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 6
    title: "\xA1HOY en FulboStars! [fecha]"
    copete: "\xA1CHUPALA MESI!"
    text: ESTRELLA DE HOY
    param: '[random]'
    color: {r: 0, g: 0.2681145, b: 0.8207547, a: 1}
    characterID: 28
    characterID2: 26
  - type: 2
    title: "\"ME GUSTAR\xCDA SER CAPIT\xC1N\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"QUIERO SER \xC1RBITRO POR UN D\xCDA\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: TA TAN TA TAN. [team1] gana [result].
    copete: DIGALO DIGALO
    text: TA TAN TA TAN. Impronunciable lo sucedido entre [team1] y [team2].
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] MARC\xD3 GOL E HIZO LA PLANCHA."
    copete: A DORMIR
    text: "Cocodrilo que se duerme esta vez no fue cartera. [team1] gan\xF3 frente
      a [team2]. El director t\xE9cnico asegur\xF3 que no hay nada que cambiar y
      que van en la direcci\xF3n correcta."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1[team1] GANA CON TRES DE DIFERENCIA!"
    copete: FUTBOL CHAMPAGNE
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] HIZO LO QUE HAB\xCDA QUE HACER."
    copete: B1L4RD1SMO
    text: "\"\xA1Esto es gatorade se\xF1orita! \xA1Y esto es fubol c4r4j0!\" grit\xF3
      el director t\xE9cnico de [team1] en los vestuarios mientras sus jugadores
      esperaban que se caliente el agua de las duchas para ba\xF1arse. "
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"VAMOS POR LOS PUNTOS"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"FUE UN PARTIDO DIFICIL"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 10
    characterID2: 21
  - type: 0
    title: "\xA1PARTIDO EXQUISITO DE [team1]!"
    copete: PARTIDO GOURMET
    text: "Una paliza le di\xF3 [team1] a [team2]. \"Fue hermoso\" declar\xF3 [goleador_team1]
      tras el paseo frente a [team2]."
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: TODO MENOS FUBOL.
    copete: MAMITA QUERIDA
    text: "[team1] puso empe\xF1o y esfuerzo pero despu\xE9s de todo un partido no
      pudo meter un gol. Pidieron que el empate se resuelva con una competencia de
      qu\xE9 equipo come m\xE1s sanguchitos de miga, pero su petici\xF3n fue rechazada."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"ERR\xC9 EL GOL PORQUE ME AHOGU\xC9 CON SALIVA\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1[team1] GANA CON TRES DE DIFERENCIA!"
    copete: FUTBOL CHAMPAGNE
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. SE FUE UN PARTIDAZO DEL MEJOR DEPORTE DEL MUNDO.'
    copete: NOSTALGIA
    text: "[team1] junto a su goleador [goleador_team1] marcaron la historia despu\xE9s
      de este partido. En el futuro los ni\xF1os leer\xE1n de esto en los libros
      de historia."
    param: played_difGoles=6
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: "\" ME ORIN\xC9 ENCIMA\""
    copete: 
    text: 
    param: 
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 7
    title: Ganaste [sobres] sobre/s!
    copete: 
    text: Abrilo/s para ganarte nuevos jugadores, oro o hacer un upgrade!
    param: played
    color: {r: 0, g: 0.2681145, b: 0.8207547, a: 1}
    characterID: 0
    characterID2: 0
  - type: 3
    title: "NACI\xD3 EL AMOR"
    copete: 
    text: "Los medios y las redes sociales est\xE1n hablando todos de la pareja del
      a\xF1o."
    param: love
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: '"ME HICIERON UNA PLANCHA"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. [team1] GANA CON 2 DE DIFERENCIA!'
    copete: A BAILAR MI AMOR
    text: "[team1] fue m\xE1s que [team2]. \"Hubo baile...\" declar\xF3 [goleador_team1],
      autor de un golazo."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"HAY QUE GANAR COMO SEA"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: NO ES HUMO DE QUEMA DE PASTIZALES, ES EL EQUIPO DE [team1].
    copete: MUCHO HUMO
    text: "El servicio metereol\xF3gico mencion\xF3 que iba a haber grandes bancos
      de niebla en los pr\xF3ximos d\xEDas gracias a este partido."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: '"LOS RESULTADOS NO IMPORTAN TANTO"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "0 GOLES. 0 M\xCDSTICA."
    copete: AVISEN CUANDO TERMINE
    text: "\xBFSabias que el partido entre [team1] y [team2] entr\xF3 en el ranking
      de partidos m\xE1s aburridos alguna vez transmitidos superando incluso a transmisiones
      de 1950 mudas y en blanco y negro?"
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"ME HICIERON TRAMPA"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: '"NUNCA SALE UNA CARTA MIA EN LOS SOBRES"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. [team1] HIZO UN OLVIDABLE PERO EFECTIVO PARTIDO.'
    copete: HAY QUE GANAR
    text: "[team1] le gan\xF3 raspando a [team2]. El equipo perdedor asegur\xF3 que
      su arquero estaba sufriendo un mal de ojo que le provoc\xF3 nauseas y dolor
      de cabeza. "
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1[team1] TUVO UNA INCREIBLE DEFINICI\xD3N!"
    copete: FUTBOL CHAMPAGNE
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"VENGO A APRENDER Y APORTAR"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: EL MEJOR PARTIDO DE LA VIDA DE [team1].
    copete: "D\xCDA INOLVIDABLE"
    text: "El [result] gener\xF3 un mar de llanto y emoci\xF3n en la hinchada y el
      equipo. Los cient\xEDficos mencionaron que este nuevo afluente limpiar\xE1
      los r\xEDos adyacentes. Un verdadero triunfo de la vida. "
    param: played_difGoles=7
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. TRAIGAN PUERTAS QUE MANIJAS SOBRAN.'
    copete: MILAGROS
    text: "[team1] hizo una ceremonia de goleadas, festejos y abrazos. Los hinchas
      comenzar\xE1n un tramite de beatificaci\xF3n para hacer santo a [goleador_team1]."
    param: played_difGoles=5
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. [team1] FUE LEVEMENTE MEJOR QUE [team2]'
    copete: TOMA PA VO
    text: "[team1] camin\xF3 mucho pero igualmente pudo ganar. Los mapas de calor
      generados a partir de los movimientos de los jugadores indican que el equipo
      se movi\xF3 menos que jubilados jugando al tejo en una plaza."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: DUDOSO RENDIMIENTO.
    copete: "\xBFQU\xC9 PAS\xD3?"
    text: "En la rueda de prensa se le pregunt\xF3 al director t\xE9cnico de [team1]
      sobre el desempe\xF1o de su equipo frente [team2] pero estaba concentrado en
      sacarse mocos duros para comerselos sigilosamente."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "SE\xD1ORA SE DESCOMPENS\xD3 EN LA TRIBUNA."
    copete: "\xBFQU\xC9 PARTIDO?"
    text: "Por suerte hab\xEDa un m\xE9dico en el lugar que pudo estabilizarla. Esto
      fue lo mas relevante de la velada. La se\xF1ora se llama Esther, le mandamos
      un beso."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"HAY QUE ENCOMENDARSE M\xC1S A LA FE\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"[random] SE ROMPI\xD3 Y NO PARABA DE CAMINAR EN EL LUGAR.\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 5
    title: '"NO PIENSO JUGAR CON NEGROS"'
    copete: 
    text: "Declar\xF3 el futbolista de [equipo] despues de preguntarle sobre su proximo
      encuentro."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 13
    characterID2: 27
  - type: 0
    title: "[result]. \xA1SI LO CANTE, SI LO GRITE, SI SE ABRACE!"
    copete: PARTIDO LIQUIDADO
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] FESTEJ\xD3 UN POCO DE M\xC1S."
    copete: "GRITOS Y ALEGR\xCDA"
    text: "[team1] hizo una fiesta en el club despu\xE9s del partido. Los jugadores
      se sacaron fotos con toda la hinchada y se mandaron en algunas canciones de
      karaoke. \"Lo importante es hacer feliz a la gente\" asegur\xF3 [goleador_team1],
      goleador del partido y muy buen imitador de Cristian Castro."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. LA FIGURA DEL PARTIDO ES TODO EL EQUIPO DE [team1].'
    copete: "\xC9XITO TOTAL"
    text: "Todo sobre el baile de [team1] a [team2]. \"Jajajajaj\" se ri\xF3 [goleador_team1],
      \xA1goleador del partido!"
    param: played_difGoles=6
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: FINAL DEL JUEGO. [team1] LA ROMPE TODA CON UN [result].
    copete: DEMOLEDORES
    text: "\xBFSabias que en algunas partes del mundo hay hoteles a punto de demolerse
      que prestan servicios a sus clientes para que vayan y colaboren a destruirlos?
      Se podria decir que el hotel al que fue [team1] es [team2]. Y solo dej\xF3
      polvo."
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1[team1] DOBLE GANADOR!"
    copete: "AS\xCD S\xCD"
    text: "\"Como te ven te tratan\" coment\xF3 el [goleador_team1] a c\xE1mara luego
      del partido. El equipo de [team1] no puede estar mejor."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result] \xA1ARRIBA LAS MANOS, ESTO ES UN ASALTO!"
    copete: CORRAN
    text: "[team1] rob\xF3 absolutamente todas las pelotas, los pases, los centros
      y los corazones de la gente en este partido marcado para la historia."
    param: played_difGoles=7
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 4
    title: MAS CAPITO
    copete: 
    text: 
    param: agresividad
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 4
    characterID2: 4
  - type: 2
    title: '"EL PASTO ESTABA MUY LARGO"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 3
    title: "\xA1SE ENAMORARON!"
    copete: 
    text: "\"Pas\xF3 mientras jugabamos\" aclararon a coro ambos jugadores"
    param: love
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"SEGUIMOS ESFORZANDONOS"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"MERECIMOS GANAR"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: TRAIGAN SPONSOR QUE [team1] ES UNA PROMESA DEL NUEVO FUBOL.
    copete: ABIBAS O NAIK
    text: '"Desde siempre los venimos a ver y miren a lo que llegamos, nos vamos
      para arriba." los hinchas lloraron emocionados despues de este partido y los
      goles de [goleador_team1].'
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: NO HUBO GOLES.
    copete: TIEMPO PERDIDO
    text: "Flojo encuentro entre [team1] y [team2]. \"Fue por aburrimiento\" declar\xF3
      [random] tras haberse quedado dormido y babearse vergonzosamente frente a c\xE1mara."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 3
    title: "\xA1PAS\xD3 DE TODO!"
    copete: 
    text: "[1] y [2] se besaron delante de las c\xE1maras"
    param: love
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 9
    characterID2: 14
  - type: 2
    title: '"EL PARTIDO FUE MEDIO RARI"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"LOS CONTRINCANTES TEN\xCDAN NARCOLEPSIA\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"UN MAL DIA LE PASA A CUALQUIERA"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"TODO PARTIDO ES UNA FINAL"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: "\"EL GRUPO EST\xC1 FUERTE\""
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: "\"NO JUEGO M\xC1S\""
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[team1] GANA [result] Y TIENE UN SAPO EN LA BARRIGA'
    copete: COMILONES
    text: "\xA1Dicen que el que come y no convida tiene un sapo en la barriga y [team1]
      tiene un estanque entero despues de haberse comido este partido y a su contrincante!"
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] ESTUVO MUY C\xD3MODO Y GAN\xD3."
    copete: VIVA EL FUBOL
    text: "El equipo de [team1] no tuvo que hacer grandes esfuerzos para superar
      a su contrincante. El [team2] tendr\xE1 que hacer m\xE1s para poder ganarle
      la pr\xF3xima vez."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1PARTIDO SO\xD1ADO PARA [team1]!"
    copete: FUTBOL CHAMPAGNE
    text: '[team1] hizo goles con estilo y elegancia para toda la vagancia. Dicen
      que [goleador_team1], autor de un gol de oro, pudo comer dos patys en vez de
      uno en el tercer tiempo.'
    param: played_difGoles=3
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: TRISTE COMO DESALOJO DE ORFANATO.
    copete: "DECEPCI\xD3N"
    text: "[team1] tuvo que salir corriendo hacia el micro. Les tiraron tomates,
      bananas podridas y billetes de 5 pesos que ya no tienen circulaci\xF3n."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xBFHay algo m\xE1s lindo que un partido de futbol como el
      que hizo [team1]?"
    copete: PREGUNTA
    text: "\xBFNo es acaso esta la magia que se presenta en lo m\xE1s elemental de
      la vida como ver a dos grupos correr tran una pelota? Felicitaciones al equipo
      ganador."
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: COLECTA DE DONACIONES PARA DARLE AL EQUIPO DE [team1] UN POCO DE FUBOL.
    copete: "VAC\xCDO FUBOL\xCDSTICO"
    text: "Para enviar una colaboraci\xF3n, cont\xE1ctese por sus redes sociales
      o llamando al 0800. Toda ayuda sirve para ayudar a [team1]."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"HUBIESE GANADO SI MIS COMPA\xD1EROS USABAN LAS PIERNAS\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 2
    characterID2: 18
  - type: 4
    title: GOLEADOR DEL PARTIDO
    copete: 
    text: 
    param: goleador
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"YO HABLO EN LA CANCHA"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"ME DOBL\xC9 LA RODILLA PEINANDOME\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "\xA1PARTIDO COMPLETAMENTE INOLVIDABLE DE [team1]!"
    copete: "SUE\xD1O CUMPLIDO"
    text: "[goleador_team1] es el jugador del momento. Luego de este partido dijo
      que recibi\xF3 numerosas ofertas de otros clubes pero que es fiel a [team1].
      Esto tambi\xE9n es fubol."
    param: played_difGoles=7
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. CANIBALISMO EN LA CANCHA.'
    copete: QUEDARON LLENOS
    text: "El equipo de [team1] se hizo un fest\xEDn y devor\xF3 a [team2] con mucho
      juego y habilidad. \"La pr\xF3xima suban m\xE1s las stats\" dijo [goleador_team1]
      burlonamente a sus contrincarios."
    param: played_difGoles=6
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"HOY ME LEVANT\xC9 CON RESACA\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 1, g: 0.6132075, b: 0.033018887, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] GAN\xD3 CAMINANDO."
    copete: FULL GAMBETA
    text: "[goleador_team1], autor de un golazo, llor\xF3 a c\xE1mara y dedic\xF3
      este partido a su mam\xE1, que todas las tardes lo esperaba en su casa con
      la chocolatada tibia y unos alfajorcitos de maicena."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] CUMPLI\xD3 Y GAN\xD3."
    copete: MUEVA MUEVA
    text: "[team1] volvi\xF3 al barrio en el micro festejando y poniendo m\xFAsica.
      Los autos de los hinchas lo siguieron tocando bocinas y gritando de felicidad."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result] \xBFC\xD3MO HAGO PARA EXPLICAR ESTO?"
    copete: "INCRE\xCDBLE"
    text: Los redactores nos encontramos completamente anonadados frente a lo que
      acaba de pasar. Sepa disculpar.
    param: played_difGoles=7
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: '"UN HINCHA GRITABA AGUDO CADA VEZ QUE TIRABA UN CENTRO"'
    copete: 
    text: "El futbolista se vi\xF3 desconcentrado frente a este suceso, como jugador
      de tenis."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. [team1] SE LLEVA EL PARTIDO DE CUL0.'
    copete: QUE SUERTE
    text: "[team2] denunci\xF3 irregularidades pero igualmente se vi\xF3 superado
      por el equipo de [team1], que se re\xEDan y les hacian chivita. "
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] GAN\xD3 CON LO JUSTO..."
    copete: POCO LUJO
    text: "[team1] gan\xF3 frente a [team2]. \"Gracias a Dios pude meterlo\" declar\xF3
      [goleador_team1], autor de un gol."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 5
    title: "[1] DI\xD3 POSITIVO EN ANTIDOPPING"
    copete: 
    text: Texto referencial sobre el tema puntual.
    param: 
    color: {r: 0.6026912, g: 0, b: 1, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"ASI ES EL FUBOL"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"NO HABLO SIN MI REPRESENTANTE"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] SUFRI\xD3 PERO LO LOGR\xD3."
    copete: RESULTADISTAS
    text: "[team1] gan\xF3 el partido. \"Si tan solo me subieran las estadisticas
      podr\xEDa jugar mejor\" declar\xF3 [goleador_team1], autor de un gol."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "\xA1[team1] GENER\xD3 UNA MASACRE TOTAL!"
    copete: TENGO MIEDO
    text: "El [result] fue un ba\xF1o de sangre y tripas perpetrado por [team1].
      El equipo de [team2] piensa en tomar acciones legales por da\xF1os psicologicos
      de primer nivel. "
    param: played_difGoles=7
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] PUDO HABER HECHO M\xC1S."
    copete: UNA CARRETA
    text: "[team1] gan\xF3 frente a [team2]. Los jugadores salieron de la cancha
      saludando bajito, apesumbrados por su propio desempe\xF1o."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. \xA1[team1] GRIT\xD3 DOS GOLES!"
    copete: "ALEGR\xCDA POPULAR"
    text: "La hinchada de [team1] termin\xF3 rompiendo una de las gradas de la cancha
      luego del festejo de este partido. Hubo heridos leves y un se\xF1or perdi\xF3
      sus pr\xF3tesis dentales al gritar desaforado, aunque tambi\xE9n declar\xF3
      que quiz\xE1s se las trag\xF3."
    param: played_difGoles=2
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "\xA1QUE SE VAYAN TODOS!"
    copete: HAGAN 1 GOL
    text: "Los hinchas dejaron pintadas las instancias de la cancha con esta frase.
      La policia tuvo que desconcentrar a la gente pero termin\xF3 uniendose a la
      moci\xF3n. No hubo incidentes."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 1
    title: '"A SEGUIR TRABAJANDO"'
    copete: 
    text: 
    param: 
    color: {r: 0.9150943, g: 0.9150943, b: 0.030215396, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. [team1] TUVO OPORTUNIDADES Y ALGUNAS LAS APROVECH\xD3."
    copete: VAMOS BIEN
    text: "El equipo [team2] denunci\xF3 que [team1] solo pudo ganar porque la hinchada
      estaba tirando humo de bengalas, papel picado, botellas de vidrio y cebollas
      peladas."
    param: played_difGoles=1
    color: {r: 0.059283756, g: 0.6320754, b: 0.032796368, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"ME ESGUINC\xC9 EL DEDO CHIQUITO DEL PIE\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. CANTALO CANTALO CANTALO \xA1[team1] GANA POR CINCO GOLES!."
    copete: GENIO, GENIO
    text: "El equipo de [team2] no pudo hacer nada. Los jugadores terminaron el partido
      e intercambiaron chombas con sus \xEDdolos, los jugadores de [team1]."
    param: played_difGoles=5
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. [team1] ES FUBOL DE ALTO VUELO .'
    copete: VUELA VUELA
    text: "Un hincha poeta de [team1] compar\xF3 al equipo de sus amores a un \xE1guila
      que vuela alto buscando peque\xF1as presas. Aclar\xF3 que los contrincantes
      ser\xEDan las presas pero que todo est\xE1 bien con ellos."
    param: played_difGoles=6
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: "\"SO\xD1\xC9 QUE GANABAMOS\""
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "SE ARM\xD3 EL BAILE. [team1] gana [result]."
    copete: DANCE DANCE
    text: "Una paliza le di\xF3 [team1] a [team2]. \"Fue hermoso\" declar\xF3 [goleador_team1]
      tras el paseo frente a [team2]."
    param: played_difGoles=4
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: "[result]. TODOS CON EL CUL0 EN LA PARED... LLEG\xD3 [team1]."
    copete: GUARDA
    text: "Los pr\xF3ximos contrincantes de [team1] est\xE1n asustados por sus futuros
      encuentros con este mounstruo del fulbo."
    param: played_difGoles=6
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 2
    title: '"NECESITO SUBIR MIS ESTADISTICAS"'
    copete: 
    text: "El astro del futbol grit\xF3 desaforada al convertir el gol para su equipo."
    param: 
    color: {r: 0.7075472, g: 0.036712356, b: 0.63073784, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: JUGANDO A OTRA COSA.
    copete: FUERA DE JUEGO
    text: "Hay rumores de que el equipo de [team1] se revel\xF3 y juegan mal porque
      quieren ser personajes de otro videojuego. Exigen ser parte de un juego de
      acci\xF3n y tiros, o en lo posible, de cocina."
    param: played_difGoles=0
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
  - type: 0
    title: '[result]. HUBO LLUVIA DE GOLES.'
    copete: UN DILUVIO
    text: "[goleador_team1] es un goleador de raza. No la toca pero cuando la toca,
      \xA1la manda a guardar!"
    param: played_difGoles=5
    color: {r: 0.8396226, g: 0, b: 0, a: 1}
    characterID: 0
    characterID2: 0
